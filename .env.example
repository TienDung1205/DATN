
# --- Backend HTTP ---
BACKEND_PORT=8000

# Origin frontend được phép gọi API
FRONTEND_ORIGIN=http://localhost:5173

# Giới hạn body JSON/form 100 KiB
BODY_LIMIT_BYTES=102400

# Thời gian chờ đóng HTTP khi dừng server: 10 giây.
SHUTDOWN_TIMEOUT_MS=10000

# --- PostgreSQL
POSTGRES_USER=datn
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=book_store_datn
POSTGRES_PORT=5433

# Chờ kết nối hoặc truy vấn database tối đa 5 giây
DATABASE_TIMEOUT_MS=5000
DATABASE_POOL_MAX=5

# --- Giới hạn request xác thực theo IP ---
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT=30
AUTH_REFRESH_RATE_LIMIT=60

# --- Đăng nhập User ---
USER_ACCESS_TOKEN_SECRET=CHANGE_ME
AUTH_ISSUER=bookstore-api
# Access token 15 phút; refresh token tối đa 7 ngày
USER_ACCESS_TOKEN_TTL_SECONDS=900
USER_REFRESH_TOKEN_TTL_SECONDS=604800

USER_COOKIE_SECURE=false
