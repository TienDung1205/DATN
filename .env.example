
# --- Backend HTTP ---
BACKEND_PORT=8000

# Origin frontend được phép gọi API
FRONTEND_ORIGIN=http://localhost:5173

# Giới hạn body JSON/form 100 KiB
BODY_LIMIT_BYTES=102400

# Thời gian chờ đóng HTTP khi dừng server: 10 giây.
SHUTDOWN_TIMEOUT_MS=10000

# --- PostgreSQL
POSTGRES_USER=datn
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=book_store_datn
POSTGRES_PORT=5433

# Chờ kết nối hoặc truy vấn database tối đa 5 giây
DATABASE_TIMEOUT_MS=5000
DATABASE_POOL_MAX=5

# --- Giới hạn request xác thực theo IP ---
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT=30
AUTH_REFRESH_RATE_LIMIT=60

# --- Đăng nhập User ---
# Secret UTF-8 tối thiểu 32 byte; có thể dùng chữ, số và ký tự đặc biệt.
USER_ACCESS_TOKEN_SECRET=CHANGE_ME
AUTH_ISSUER=bookstore-api
# Access token 15 phút; refresh token tối đa 7 ngày
USER_ACCESS_TOKEN_TTL_SECONDS=900
USER_REFRESH_TOKEN_TTL_SECONDS=604800

USER_COOKIE_SECURE=false

# --- Đăng nhập Admin ---
# Secret riêng, khác User; UTF-8 tối thiểu 32 byte.
ADMIN_ACCESS_TOKEN_SECRET=CHANGE_ME
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_SECONDS=604800
ADMIN_COOKIE_SECURE=false
ADMIN_LOGIN_RATE_LIMIT=20
ADMIN_REFRESH_RATE_LIMIT=60

# Docker tự tạo quản lý sau migration: email trùng thì bỏ qua, email mới thì tạo.
# Để trống cả 3 biến để bỏ qua seed. Mật khẩu theo quy tắc.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=

# --- Upload ảnh (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=datn
# Tối đa 5 MiB mỗi ảnh, chờ Cloudinary tối đa 30 giây.
IMAGE_MAX_BYTES=5242880
IMAGE_UPLOAD_TIMEOUT_MS=30000
IMAGE_UPLOAD_CONCURRENCY=3
