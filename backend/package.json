{
  "name": "bookstore-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bookstore",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "auth:setup": "node scripts/setup-user-auth.mjs",
    "admin:seed": "node dist/scripts/seedAdmin.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cookie": "2.0.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
