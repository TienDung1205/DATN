{
  "name": "bookstore-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bookstore backend - health API",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
