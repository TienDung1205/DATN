generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  BLOCKED
}

enum AdminRole {
  MANAGER
  STAFF
}

model Admin {
  id               BigInt           @id @default(autoincrement())
  email            String           @unique
  password         String
  fullName         String           @map("full_name")
  phone            String?
  status           AccountStatus    @default(ACTIVE)
  role             AdminRole
  createdByAdminId  BigInt?          @map("created_by_admin_id")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        Admin?           @relation("AdminCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAdmins    Admin[]          @relation("AdminCreator")
  sessions         RefreshSession[]

  @@index([createdByAdminId])
  @@index([role])
  @@map("admins")
}

model User {
  id        BigInt           @id @default(autoincrement())
  email     String           @unique
  password  String
  fullName  String           @map("full_name")
  phone     String?          @unique
  avatar    String?
  status    AccountStatus    @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions  RefreshSession[]

  @@map("users")
}

model RefreshSession {
  id                  BigInt           @id @default(autoincrement())
  userId              BigInt?          @map("user_id")
  adminId             BigInt?          @map("admin_id")
  familyId            String           @map("family_id") @db.Uuid
  tokenHash           String           @unique @map("token_hash")
  expiresAt           DateTime         @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime?        @map("revoked_at") @db.Timestamptz(3)
  replacedBySessionId BigInt?          @map("replaced_by_session_id")
  lastUsedAt          DateTime?        @map("last_used_at") @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user                User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  admin               Admin?           @relation(fields: [adminId], references: [id], onDelete: Restrict)
  replacement         RefreshSession?  @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: Restrict)
  predecessors        RefreshSession[] @relation("SessionRotation")

  @@index([userId, expiresAt])
  @@index([adminId, expiresAt])
  @@index([familyId])
  @@index([replacedBySessionId])
  @@map("refresh_sessions")
}
